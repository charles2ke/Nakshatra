{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "users": { "ClusterId": "user", "Match": { "Path": "/api/users/{**catch-all}" } },
      "users-root": { "ClusterId": "user", "Match": { "Path": "/api/users" } },
      "personas": { "ClusterId": "user", "Match": { "Path": "/api/personas" } },
      "vendors": { "ClusterId": "vendor", "Match": { "Path": "/api/vendors/{**catch-all}" } },
      "vendors-root": { "ClusterId": "vendor", "Match": { "Path": "/api/vendors" } },
      "products": { "ClusterId": "catalog", "Match": { "Path": "/api/products/{**catch-all}" } },
      "products-root": { "ClusterId": "catalog", "Match": { "Path": "/api/products" } },
      "search": { "ClusterId": "search", "Match": { "Path": "/api/search/{**catch-all}" } },
      "search-root": { "ClusterId": "search", "Match": { "Path": "/api/search" } },
      "cart": { "ClusterId": "cart", "Match": { "Path": "/api/cart/{**catch-all}" } },
      "recommendations": { "ClusterId": "recommendation", "Match": { "Path": "/api/recommendations/{**catch-all}" } },
      "orders": { "ClusterId": "order", "Match": { "Path": "/api/orders/{**catch-all}" } },
      "orders-root": { "ClusterId": "order", "Match": { "Path": "/api/orders" } },
      "fulfillment": { "ClusterId": "fulfillment", "Match": { "Path": "/api/fulfillment/{**catch-all}" } },
      "payments": { "ClusterId": "payment", "Match": { "Path": "/api/payments/{**catch-all}" } },
      "payments-root": { "ClusterId": "payment", "Match": { "Path": "/api/payments" } },
      "billing": { "ClusterId": "billing", "Match": { "Path": "/api/billing/{**catch-all}" } }
    },
    "Clusters": {
      "user": { "Destinations": { "d1": { "Address": "http://localhost:5001" } } },
      "vendor": { "Destinations": { "d1": { "Address": "http://localhost:5002" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://localhost:5003" } } },
      "search": { "Destinations": { "d1": { "Address": "http://localhost:5004" } } },
      "cart": { "Destinations": { "d1": { "Address": "http://localhost:5005" } } },
      "recommendation": { "Destinations": { "d1": { "Address": "http://localhost:5006" } } },
      "order": { "Destinations": { "d1": { "Address": "http://localhost:5007" } } },
      "fulfillment": { "Destinations": { "d1": { "Address": "http://localhost:5008" } } },
      "payment": { "Destinations": { "d1": { "Address": "http://localhost:5009" } } },
      "billing": { "Destinations": { "d1": { "Address": "http://localhost:5010" } } }
    }
  }
}
